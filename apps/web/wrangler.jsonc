{
	// Publicação do site do Mirante na Cloudflare (plano grátis): só arquivos estáticos, como SPA.
	// Arquivos estáticos não contam no limite de pedidos dos Workers.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mirante",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	}
}
