{
	"name": "mirante",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*"],
	"packageManager": "bun@1.4.4",
	"engines": { "node": ">=22.17" },
	"scripts": {
		"dev": "bun run --cwd apps/web dev",
		"build": "bun run --cwd apps/web build",
		"build:prototipo": "bun run --cwd apps/web build:prototipo",
		"check": "bun run --cwd apps/web check",
		"lint": "bun run --cwd apps/web lint",
		"test": "bun run --cwd apps/web test",
		"test:e2e": "bun run --cwd apps/web test:e2e"
	}
}
